<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nothing_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPENROUTER"
            android:textColor="@color/nothing_white"
            android:textSize="22sp"
            android:letterSpacing="0.18"
            android:fontFamily="monospace"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CONTROL PANEL"
            android:textColor="@color/nothing_gray"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/nothing_border"/>

        <LinearLayout
            android:id="@+id/groupLoggedOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paste your OpenRouter API key to get started."
                android:textColor="@color/nothing_gray"
                android:textSize="12sp"
                android:fontFamily="monospace"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="API KEY"
                android:textColor="@color/nothing_white"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:fontFamily="monospace"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Create one at openrouter.ai/settings/keys"
                android:textColor="@color/nothing_gray"
                android:textSize="10sp"
                android:fontFamily="monospace"/>

            <EditText
                android:id="@+id/inputUserKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/nothing_border"
                android:hint="sk-or-v1-..."
                android:textColor="@color/nothing_white"
                android:textColorHint="@color/nothing_gray"
                android:fontFamily="monospace"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>

            <Button
                android:id="@+id/buttonSaveUserKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/nothing_white"
                android:text="VERIFY AND SAVE"
                android:textColor="@color/nothing_black"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ACCOUNT CONNECTED"
                    android:textColor="@color/nothing_green"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/buttonLogout"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="LOGOUT"
                    android:textColor="@color/nothing_red"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/nothing_border"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="1 · DISPLAY MODE"
                android:textColor="@color/nothing_white"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:fontFamily="monospace"/>

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account balance (remaining credit)"
                    android:textColor="@color/nothing_white"
                    android:fontFamily="monospace"
                    android:buttonTint="@color/nothing_red"/>

                <RadioButton
                    android:id="@+id/radioKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API key usage (this key)"
                    android:textColor="@color/nothing_white"
                    android:fontFamily="monospace"
                    android:buttonTint="@color/nothing_red"/>
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/nothing_border"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="2 · ALERT THRESHOLD ($)"
                android:textColor="@color/nothing_white"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/hintThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Widget turns red when balance drops below this value"
                android:textColor="@color/nothing_gray"
                android:textSize="10sp"
                android:fontFamily="monospace"/>

            <EditText
                android:id="@+id/inputThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/nothing_border"
                android:hint="2.00"
                android:textColor="@color/nothing_white"
                android:textColorHint="@color/nothing_gray"
                android:fontFamily="monospace"
                android:inputType="numberDecimal"/>

            <Button
                android:id="@+id/buttonSaveConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/nothing_white"
                android:text="SAVE AND REFRESH WIDGET"
                android:textColor="@color/nothing_black"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="READY"
            android:textColor="@color/nothing_gray"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:fontFamily="monospace"/>
    </LinearLayout>
</ScrollView>